{
  "manifest_version": 3,
  "name": "FlowState",
  "version": "1.0.0",
  "description": "Privacy-conscious activity tracking for FlowState digital wellbeing.",
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "host_permissions": [
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "http://192.168.*:*/*",
    "http://10.*:*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FlowState"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
