# FlowState — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to source control.

# ────────────────────────────────────────────
# PostgreSQL (used by Spring Boot + Docker)
# ────────────────────────────────────────────
POSTGRES_DB=flowstate
POSTGRES_USER=flowstate_user
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ────────────────────────────────────────────
# Spring Boot Backend
# ────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/flowstate
SPRING_DATASOURCE_USERNAME=flowstate_user
SPRING_DATASOURCE_PASSWORD=changeme_in_production

# JWT — generate a strong random secret (min 256 bits)
JWT_SECRET=replace_with_secure_random_base64_string
JWT_EXPIRATION_MS=86400000

# Backend port
SERVER_PORT=8080

# ML service URL (called by Spring Boot for classification)
ML_SERVICE_URL=http://localhost:8001

# ────────────────────────────────────────────
# ML FastAPI Service
# ────────────────────────────────────────────
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8001
ML_MODEL_PATH=ml/models/classifier.joblib

# ────────────────────────────────────────────
# Linux Agent
# ────────────────────────────────────────────
FLOWSTATE_API_URL=http://localhost:8080
FLOWSTATE_API_TOKEN=paste_jwt_token_here
FLOWSTATE_DEVICE_ID=auto
FLOWSTATE_POLL_INTERVAL_SECONDS=30
FLOWSTATE_BUFFER_DB=agents/linux/buffer.db

# ────────────────────────────────────────────
# Browser Extension (injected at build time)
# ────────────────────────────────────────────
EXT_API_BASE_URL=http://localhost:8080
